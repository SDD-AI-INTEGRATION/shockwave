POSTGRES_PASSWORD=replace-with-random-strong-password
WEB_PORT=8080
# Default satu komputer; launcher -Lan mengisi nilai LAN yang sesuai.
WEB_BIND=127.0.0.1
APP_ORIGIN=http://localhost:8080
APP_ORIGINS=
LAN_HTTP=false
# Early warning: interval pemeriksaan (menit, 0 = nonaktif). Peringatan merah
# juga dikirim ke Microsoft Teams bila URL webhook Workflows diisi.
EARLY_WARNING_INTERVAL_MINUTES=60
TEAMS_WEBHOOK_URL=
# Asisten PMO memakai OpenAI saat kunci diisi; ringkasan proyek yang boleh
# diakses penanya dikirim ke OpenAI API. Kosongkan untuk mode aturan lokal.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
ASSISTANT_AI=on
